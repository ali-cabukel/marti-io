# Application
APP_ENV=development
APP_NAME=Daily Agent Hub
API_PREFIX=/api
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# CORS (comma-separated)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# Rate limits (slowapi — REST endpoints only)
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_CHAT=20/minute

# LLM (OpenAI-compatible; default host is api.openai.com)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=gpt-4o-mini

# News (optional — https://newsapi.org; falls back to Google News RSS)
NEWS_API_KEY=

# Postgres checkpointer (LangGraph thread memory)
CHECKPOINTER=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agents
# Optional Postgres schema for shared Supabase DB (e.g. marti-io on Cloud Run)
# DATABASE_SCHEMA=marti-io

# SQLite fallback (set CHECKPOINTER=sqlite)
SQLITE_PATH=./data/checkpoints.db

# Redis (optional — WebSocket pub/sub for multi-instance scaling)
# Leave unset for single-instance / serverless deployments (local in-process fan-out).
# REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_PAYLOADS=true
LOG_HTTP_PAYLOADS=true

# Uvicorn WebSocket keepalive (auto-enabled when APP_ENV=staging|production)
# WS_PING_INTERVAL=20
# WS_PING_TIMEOUT=20
# TIMEOUT_KEEP_ALIVE=75

# Static files (built from web/ — leave unset to use src/agents/static)
# STATIC_DIR=
